            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key findings",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#252A31",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Real wages: Croatia 116.6 vs EU27 104.5 in 2024 (2010 = 100); 12th of 26 member states.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252A31"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Inflation hit 10.7 % (2022) and 8.4 % (2023), but wages grew faster: Croatian real wages rose 1.6 % and 4.6 % while EU real wages fell.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252A31"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Housing: 2015–2024 house prices +99 %, wages +67 %, so housing is ~20 % less affordable (EU: 15 %).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252A31"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Catching up: GDP per capita (PPS) rose from 61 % of the EU average in 2010 to 78 % in 2025 (p).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252A31"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "(p) provisional",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#5B6470"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
