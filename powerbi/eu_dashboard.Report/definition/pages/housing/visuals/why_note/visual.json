    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why can real wages rise while housing gets less affordable?",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#252A31",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Real wages are deflated by the HICP, which excludes owner-occupied housing costs and house purchases (Eurostat, 2023).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252A31"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "So rising house prices do not show up in consumer price inflation: wages can beat the HICP while falling behind house prices.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252A31"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No data: Greece (house prices), the Netherlands (wages).",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#5B6470"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
