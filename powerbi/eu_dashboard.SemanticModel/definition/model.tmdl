model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: hr-BA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["bi_dim_country","bi_dim_indicator","bi_dim_year","v_country_rank","v_annual_summary","v_known_gaps","v_quality_latest","v_observations","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table bi_dim_country
ref table bi_dim_indicator
ref table bi_dim_year
ref table v_country_rank
ref table v_annual_summary
ref table v_known_gaps
ref table v_quality_latest
ref table v_observations
ref table 'Base Year'
ref table _Measures

ref cultureInfo en-US

