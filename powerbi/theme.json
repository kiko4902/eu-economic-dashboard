{
  "name": "EU Economic Dashboard",
  "dataColors": [
    "#C8102E",
    "#1F4E9E",
    "#2A9D8F",
    "#E09F3E",
    "#6C757D",
    "#8E6C8A",
    "#4C9F70",
    "#B5651D",
    "#5FA8D3",
    "#A3A3A3"
  ],
  "background": "#FFFFFF",
  "backgroundLight": "#F4F5F7",
  "backgroundNeutral": "#D9DDE2",
  "foreground": "#252A31",
  "foregroundNeutralSecondary": "#5B6470",
  "foregroundNeutralTertiary": "#9AA3AD",
  "tableAccent": "#1F4E9E",
  "good": "#2E8B57",
  "neutral": "#E09F3E",
  "bad": "#C8102E",
  "maximum": "#1F4E9E",
  "center": "#F4F5F7",
  "minimum": "#C8102E",
  "null": "#D9DDE2",
  "hyperlink": "#1F4E9E",
  "visitedHyperlink": "#5B3E8C",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#252A31"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#252A31"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#252A31"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5B6470"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#252A31" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E3E6EA" } },
            "radius": 4
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F5F7" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
